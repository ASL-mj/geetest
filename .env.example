# Application mode
APP_ENV=local

# Backend runtime (plain postgres:// or postgresql:// DSN, pgx-compatible)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/geetest_platform
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-me-session-secret
SESSION_TTL_SECONDS=604800
API_KEY_PEPPER=change-me-api-key-pepper
CDK_PEPPER=change-me-cdk-pepper
GEETEST_SOLVER_URL=https://solver.internal.example.com
GEETEST_SERVICE_API_KEY=change-me-geetest-service-api-key

# Frontend
VITE_API_BASE_URL=http://localhost:8000

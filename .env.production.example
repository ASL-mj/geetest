# This file is a template. Copy it to .env on the server and replace every
# placeholder before starting the production stack. It must stay untracked.
APP_ENV=production

POSTGRES_DB=captchaflow
POSTGRES_USER=captchaflow
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
DATABASE_URL=postgres://captchaflow:replace-with-a-random-hex-secret@postgres:5432/captchaflow?sslmode=disable
REDIS_URL=redis://redis:6379/0

SESSION_SECRET=replace-with-a-random-hex-secret
SESSION_TTL_SECONDS=604800
API_KEY_PEPPER=replace-with-a-random-hex-secret
CDK_PEPPER=replace-with-a-random-hex-secret

# Server-only internal solver configuration. Never expose either value in the
# web application, reverse-proxy configuration, source control, or logs.
GEETEST_SOLVER_URL=https://solver.internal.example.com
GEETEST_SERVICE_API_KEY=replace-with-the-internal-service-key
SOLVER_CONNECT_TIMEOUT_SECONDS=10
SOLVER_READ_TIMEOUT_SECONDS=120
SOLVER_TOTAL_TIMEOUT_SECONDS=130

RATE_LIMIT_PER_MINUTE=60
CONCURRENCY_LIMIT=4
TRUST_PROXY_XFF_HOPS=1
AUTO_MIGRATE=1

# Required for the first API startup only. Remove the password after the
# administrator account has been created and the first login has been tested.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SESSION_TTL_SECONDS=86400
